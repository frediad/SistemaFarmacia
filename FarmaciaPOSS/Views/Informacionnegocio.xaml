<Window x:Class="FarmaciaPOS.Views.InformacionNegocio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Información del Negocio"
        Height="620"
        Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F4F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="BotonModerno" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- ENCABEZADO -->
        <Border Height="90" VerticalAlignment="Top" CornerRadius="0,0,20,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E3A8A" Offset="0"/>
                    <GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🏢  Información del Negocio" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Datos fiscales y de contacto" FontSize="12" Foreground="#BFDBFE" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Margin="30,110,30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- TARJETA DE DATOS -->
            <Border Background="White" CornerRadius="14" Padding="25">
                <StackPanel x:Name="panelContenido">

                    <TextBlock x:Name="txtSinDatos"
                               Text="No se encontró información del negocio configurada todavía. Ve a Configuración de Ticket para registrarla."
                               FontSize="13"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,0,0,15"/>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="NOMBRE DEL NEGOCIO" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock x:Name="txtNombre" Text="—" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#EAF3FE">
                            <TextBlock Text="🧾" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RFC" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock x:Name="txtRFC" Text="—" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#EAF7EC">
                            <TextBlock Text="📍" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DIRECCIÓN" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock x:Name="txtDireccion" Text="—" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="380"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#FFF3DE">
                            <TextBlock Text="📞" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TELÉFONO" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock x:Name="txtTelefono" Text="—" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#F2ECFB">
                            <TextBlock Text="✉️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CORREO" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock x:Name="txtCorreo" Text="—" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- BOTÓN CERRAR -->
            <Button Grid.Row="1"
                    Content="⬅  Cerrar"
                    Width="150" Height="42"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0"
                    Background="#616161"
                    Style="{StaticResource BotonModerno}"
                    Click="BtnCerrar_Click"/>

        </Grid>

    </Grid>

</Window>
