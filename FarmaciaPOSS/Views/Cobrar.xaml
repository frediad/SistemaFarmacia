<Window x:Class="FarmaciaPOS.Views.Cobrar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobrar Venta"
        Height="660"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F4F8">

    <Window.Resources>

        <Style x:Key="BtnConfirmar" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TxtMonto" TargetType="TextBox">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CboMetodoPago" TargetType="ComboBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

    </Window.Resources>

    <Border Background="White" CornerRadius="16" Margin="14">

        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="24" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#1693E0"
                    CornerRadius="16,16,0,0">
                <TextBlock Text="💳  Cobrar Venta"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="20,0"/>
            </Border>

            <!-- RESUMEN DE PRODUCTOS -->
            <DataGrid x:Name="dgResumenVenta"
                      Grid.Row="1"
                      Margin="16,12"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      FontSize="13"
                      RowHeight="34"
                      BorderThickness="1"
                      BorderBrush="#E2E8F0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="55"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Importe" Binding="{Binding Subtotal, StringFormat=C}" Width="100"/>
                </DataGrid.Columns>

            </DataGrid>

            <!-- TOTAL -->
            <StackPanel Grid.Row="2" Margin="20,0,20,10">

                <Grid Margin="0,2">
                    <TextBlock Text="TOTAL" FontSize="20" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="txtTotalCobrar" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Right"/>
                </Grid>

            </StackPanel>

            <!-- MÉTODO DE PAGO -->
            <StackPanel Grid.Row="3" Margin="20,0,20,10">

                <TextBlock Text="MÉTODO DE PAGO"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#94A3B8"
                           Margin="2,0,0,6"/>

                <ComboBox x:Name="cbMetodoPago"
                          Height="44"
                          Style="{StaticResource CboMetodoPago}"
                          SelectionChanged="cbMetodoPago_SelectionChanged">
                    <ComboBoxItem Content="Efectivo" IsSelected="True"/>
                    <ComboBoxItem Content="Tarjeta"/>
                    <ComboBoxItem Content="Transferencia"/>
                </ComboBox>

            </StackPanel>

            <!-- MONTO RECIBIDO / CAMBIO -->
            <Grid Grid.Row="4" Margin="20,0,20,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,8,0">
                    <TextBlock x:Name="txtEtiquetaMonto"
                               Text="MONTO RECIBIDO"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#94A3B8"
                               Margin="2,0,0,6"/>
                    <TextBox x:Name="txtMontoRecibido"
                             Height="52"
                             Style="{StaticResource TxtMonto}"
                             TextChanged="txtMontoRecibido_TextChanged"
                             KeyDown="txtMontoRecibido_KeyDown"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="CAMBIO" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="2,0,0,6"/>
                    <Border Height="52" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="10">
                        <TextBlock x:Name="txtCambioCobrar"
                                   Text="$0.00"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

            </Grid>

            <!-- BOTONES -->
            <Grid Grid.Row="5" Margin="20,0,20,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Cancelar"
                        Height="48"
                        Background="Transparent"
                        Foreground="#64748B"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="1"
                        BorderBrush="#E2E8F0"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        Click="BtnCancelarCobro_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="1"
                        Content="✅ Confirmar Venta"
                        Height="48"
                        Style="{StaticResource BtnConfirmar}"
                        Click="BtnConfirmarVenta_Click"/>

            </Grid>

        </Grid>

    </Border>

</Window>