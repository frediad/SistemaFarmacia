<Window x:Class="FarmaciaPOS.Views.Perifericos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Periféricos"
        Height="680"
        Width="820"
        Icon="/farma.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <Window.Resources>

        <Style x:Key="TxtConfig" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CboConfig" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style x:Key="BtnAccionConfig" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario tipo "link" — para acciones de soporte (abrir
             herramientas de Windows) que no son la acción principal del panel -->
        <Style x:Key="BtnLinkConfig" TargetType="Button">
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="#1E3A8A" Grid.Row="0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🖥️  Periféricos"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="✕ Cerrar"
                        Width="90"
                        Height="36"
                        FontSize="13"
                        FontWeight="Bold"
                        Background="#DC2626"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="BtnCerrarVentana_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- PESTAÑAS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="15">

            <!-- ===================================== -->
            <!-- IMPRESORA DE TICKETS                   -->
            <!-- ===================================== -->

            <TabItem Header="🖨️ Impresora de Tickets">

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                    <StackPanel>

                        <!-- ===== Selección de impresora ===== -->
                        <Border Background="White" CornerRadius="12" Padding="20">

                            <StackPanel>

                                <TextBlock Text="Selecciona la impresora de tickets"
                                   FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>

                                <TextBlock Text="Se usará esta impresora cada vez que el sistema genere un ticket de venta."
                                   FontSize="12" Foreground="#94A3B8" Margin="0,4,0,20"/>

                                <ComboBox x:Name="cbImpresoras"
                                  Height="42"
                                  Style="{StaticResource CboConfig}"
                                  SelectionChanged="CbImpresoras_SelectionChanged"
                                  Margin="0,0,0,12"/>

                                <!-- ✅ Estado de conexión en vivo -->
                                <Border x:Name="pnlEstadoConexion"
                                Background="#F8FAFC"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,0,0,15"
                                Visibility="Collapsed">

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="elipseEstadoConexion"
                                             Width="10" Height="10"
                                             Fill="Gray"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                                            <TextBlock x:Name="txtEstadoConexion"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Width="600"/>
                                        </StackPanel>

                                        <Button x:Name="btnInstalarControlador"
                                        Content="⚙️ Instalar controlador de esta impresora"
                                        Style="{StaticResource BtnLinkConfig}"
                                        HorizontalAlignment="Left"
                                        Margin="20,10,0,0"
                                        Visibility="Collapsed"
                                        Click="BtnInstalarControlador_Click"/>
                                    </StackPanel>

                                </Border>

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="🔄 Actualizar lista"
                                    Height="42"
                                    Background="#64748B"
                                    Style="{StaticResource BtnAccionConfig}"
                                    Click="BtnActualizarImpresoras_Click"/>

                                    <Button Grid.Column="2"
                                    Content="🖨️ Imprimir ticket de prueba"
                                    Height="42"
                                    Background="#2563EB"
                                    Style="{StaticResource BtnAccionConfig}"
                                    Click="BtnProbarImpresora_Click"/>
                                </Grid>

                                <TextBlock x:Name="txtEstadoImpresora"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,15,0,0"
                                   TextWrapping="Wrap"/>

                                <Button x:Name="btnAgregarImpresoraWindows"
                                Content="➕ Agregar o vincular una impresora nueva en Windows"
                                Style="{StaticResource BtnLinkConfig}"
                                HorizontalAlignment="Left"
                                Margin="0,16,0,0"
                                Click="BtnAgregarImpresoraWindows_Click"/>

                            </StackPanel>

                        </Border>

                        <!-- ===== Dispositivos con problemas de controlador (general) ===== -->
                        <Border x:Name="pnlDispositivosConProblemas"
                        Background="White"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,15,0,0"
                        Visibility="Collapsed">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Dispositivos con problemas detectados"
                                       FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                                </StackPanel>

                                <TextBlock x:Name="txtResumenProblemas"
                                   FontSize="12" Foreground="#94A3B8" Margin="0,4,0,14"
                                   TextWrapping="Wrap"/>

                                <ItemsControl x:Name="lstDispositivosConProblemas">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEF2F2"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nombre}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="#991B1B"/>
                                                    <TextBlock Text="{Binding DescripcionError}"
                                                       FontSize="12"
                                                       Foreground="#B91C1C"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="🔄 Volver a revisar"
                                    Height="40"
                                    Background="#64748B"
                                    Style="{StaticResource BtnAccionConfig}"
                                    Click="BtnActualizarDispositivos_Click"/>

                                    <Button Grid.Column="2"
                                    Content="🛠️ Administrador de dispositivos"
                                    Height="40"
                                    Background="#2563EB"
                                    Style="{StaticResource BtnAccionConfig}"
                                    Click="BtnAbrirAdministradorDispositivos_Click"/>

                                    <Button Grid.Column="4"
                                    Content="🔍 Buscar en Windows Update"
                                    Height="40"
                                    Background="#0EA5E9"
                                    Style="{StaticResource BtnAccionConfig}"
                                    Click="BtnBuscarEnWindowsUpdate_Click"/>
                                </Grid>

                                <TextBlock TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   Margin="0,12,0,0">
                            Por seguridad, Windows requiere que la instalación de controladores se haga
                            desde sus propias herramientas — estos botones abren directamente la
                            correspondiente, tú solo debes seguir los pasos.
                                </TextBlock>

                            </StackPanel>

                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </TabItem>

            <!-- ===================================== -->
            <!-- ESCÁNER                                -->
            <!-- ===================================== -->

            <TabItem Header="🔍 Escáner de Código de Barras">

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,15,0,0">

                    <StackPanel>

                        <TextBlock Text="Prueba de funcionamiento del escáner"
                                   FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>

                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12" Foreground="#94A3B8" Margin="0,4,0,20">
                            La mayoría de los lectores de código de barras funcionan como un teclado (no requieren
                            controlador especial). Para verificar que funciona, haz clic en el campo de abajo y
                            escanea cualquier código de barras — el sistema detecta si la entrada llegó demasiado
                            rápido para haber sido escrita a mano.
                        </TextBlock>

                        <TextBox x:Name="txtPruebaEscaner"
                                 PreviewTextInput="txtPruebaEscaner_PreviewTextInput"
                                 PreviewKeyDown="txtPruebaEscaner_PreviewKeyDown"
                                 GotFocus="txtPruebaEscaner_GotFocus"/>

                        <Border x:Name="borderResultadoEscaner"
                                Background="#F8FAFC"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,15,0,0"
                                Visibility="Collapsed">

                            <StackPanel>
                                <TextBlock x:Name="txtResultadoEscaner"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtDetalleEscaner"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                        </Border>

                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,20,0,0">
                            Si el escáner no responde en absoluto (ni siquiera como teclado), es probable
                            que sea un modelo con controlador propio (poco común). En ese caso, usa el botón
                            de abajo para revisar si Windows detectó el dispositivo con algún problema.
                        </TextBlock>

                        <Button Content="🛠️ Revisar dispositivos con problemas de controlador"
                                Style="{StaticResource BtnLinkConfig}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Click="BtnAbrirAdministradorDispositivos_Click"/>

                    </StackPanel>

                </Border>

            </TabItem>

        </TabControl>

    </Grid>

</Window>
