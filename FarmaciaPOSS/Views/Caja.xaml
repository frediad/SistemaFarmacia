<Window x:Class="FarmaciaPOS.Views.CajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caja"
        Height="700"
        Width="1100"
        Icon="/logo-icono.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <Window.Resources>

        <Style x:Key="TxtCaja" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="CaretBrush" Value="#2563EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TxtCorteCelda" TargetType="TextBox" BasedOn="{StaticResource TxtCaja}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="CboCaja" TargetType="ComboBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style x:Key="BtnCajaBase" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAbrirCajaEstilo" TargetType="Button" BasedOn="{StaticResource BtnCajaBase}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="BtnMovimientoEstilo" TargetType="Button" BasedOn="{StaticResource BtnCajaBase}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="BtnCerrarCajaEstilo" TargetType="Button" BasedOn="{StaticResource BtnCajaBase}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="BtnCorteEstilo" TargetType="Button" BasedOn="{StaticResource BtnCajaBase}">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================== -->
        <!-- HEADER                                -->
        <!-- ===================================== -->

        <Border Background="#1E3A8A" Grid.Row="0">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🧾  Control de Caja"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="✕ Cerrar"
                        Width="100"
                        Height="40"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="#DC2626"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="BtnCerrarVentana_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>

        </Border>

        <!-- ===================================== -->
        <!-- ✅ CONTENIDO ÚNICO (ya sin pestañas)   -->
        <!-- ===================================== -->

        <Grid Grid.Row="1" Margin="20,15,20,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================== -->
            <!-- PANEL IZQUIERDO                       -->
            <!-- ===================================== -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,15,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- APERTURA (visible solo si no hay caja abierta) -->
                        <StackPanel x:Name="pnlApertura">

                            <TextBlock Text="💰 Apertura de Caja"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="MONTO INICIAL"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#94A3B8"
                                       Margin="2,0,0,6"/>

                            <TextBox x:Name="txtMontoInicial"
                                     Height="42"
                                     Style="{StaticResource TxtCaja}"
                                     Margin="0,0,0,14"/>

                            <Button x:Name="btnAbrirCaja"
                                    Content="🔓 ABRIR CAJA"
                                    Height="46"
                                    Style="{StaticResource BtnAbrirCajaEstilo}"
                                    Click="BtnAbrirCaja_Click"/>

                        </StackPanel>

                        <!-- MOVIMIENTOS (visible solo si hay caja abierta) -->
                        <StackPanel x:Name="pnlMovimientos" Visibility="Collapsed">

                            <TextBlock Text="🔄 Registrar Movimiento"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="TIPO DE MOVIMIENTO"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#94A3B8"
                                       Margin="2,0,0,6"/>

                            <ComboBox x:Name="cbTipoMovimiento"
                                      Height="42"
                                      Style="{StaticResource CboCaja}"
                                      Margin="0,0,0,14">

                                <ComboBoxItem Content="ENTRADA"/>
                                <ComboBoxItem Content="SALIDA"/>

                            </ComboBox>

                            <TextBlock Text="MONTO"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#94A3B8"
                                       Margin="2,0,0,6"/>

                            <TextBox x:Name="txtMontoMovimiento"
                                     Height="42"
                                     Style="{StaticResource TxtCaja}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="MOTIVO"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#94A3B8"
                                       Margin="2,0,0,6"/>

                            <TextBox x:Name="txtMotivo"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Style="{StaticResource TxtCaja}"
                                     Margin="0,0,0,18"/>

                            <Button Content="📝 REGISTRAR MOVIMIENTO"
                                    Height="46"
                                    Style="{StaticResource BtnMovimientoEstilo}"
                                    Click="BtnMovimiento_Click"/>

                            <Separator Margin="0,24" Background="#E2E8F0"/>

                            <Button Content="🧮 REALIZAR CORTE DE CAJA"
                                    Height="46"
                                    Style="{StaticResource BtnCorteEstilo}"
                                    Margin="0,0,0,12"
                                    Click="BtnAbrirCorte_Click"/>

                            <Button Content="🔒 CERRAR CAJA SIN CORTE"
                                    Height="42"
                                    Background="#94A3B8"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BtnCerrarCaja_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- ===================================== -->
            <!-- PANEL DERECHO                         -->
            <!-- ===================================== -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- RESUMEN EN VIVO -->
                <Border Background="#1E293B"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,15">

                    <UniformGrid Columns="7">

                        <StackPanel Margin="6,0" HorizontalAlignment="Center">
                            <TextBlock Text="MONTO INICIAL" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtResumenInicial" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="6,0" HorizontalAlignment="Center">
                            <TextBlock Text="VENTAS EFECT." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtResumenVentasEfectivo" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="6,0" HorizontalAlignment="Center">
                            <TextBlock Text="VENTAS TARJETA" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtResumenVentasTarjeta" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="6,0" HorizontalAlignment="Center">
                            <TextBlock Text="VENTAS TRANSF." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtResumenVentasTransferencia" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="6,0" HorizontalAlignment="Center">
                            <TextBlock Text="ENTRADAS" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtResumenEntradas" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="6,0" HorizontalAlignment="Center">
                            <TextBlock Text="SALIDAS" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtResumenSalidas" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#F87171" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="6,0" HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL ESPERADO" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtResumenEsperado" Text="$0.00" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                        </StackPanel>

                    </UniformGrid>

                </Border>

                <!-- MOVIMIENTOS -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="18">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Movimientos de la Caja Actual"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,12"/>

                        <DataGrid x:Name="dgMovimientos"
                                  Grid.Row="1"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  RowHeight="36"
                                  FontSize="14"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                        </DataGrid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

        <!-- ===================================== -->
        <!-- ✅ OVERLAY: CORTE DE CAJA (ESTILO SICAR) -->
        <!-- ===================================== -->

        <Border x:Name="overlayCorte"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="#B0000000"
                Visibility="Collapsed">

            <Border Background="White"
                    CornerRadius="16"
                    Width="640"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="26">

                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="🧮 Corte de Caja"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="Confirma el efectivo, tarjeta y transferencias recibidas"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,0,0,18"/>

                    <!-- ===== TABLA DE CORTE ===== -->
                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="0"
                            Margin="0,0,0,18">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ENCABEZADOS -->
                            <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#1E293B" CornerRadius="10,10,0,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="MÉTODO" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="CONTADO" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="CALCULADO" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="DIFERENCIA" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- EFECTIVO -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="💵 Efectivo" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <TextBox x:Name="txtContadoEfectivo" Grid.Row="1" Grid.Column="1" Text="0" Width="90" Height="34" Style="{StaticResource TxtCorteCelda}" TextChanged="ContadoCorte_TextChanged"/>
                            <TextBlock x:Name="txtCalculadoEfectivo" Grid.Row="1" Grid.Column="2" Text="$0.00" FontSize="14" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtDiferenciaEfectivo" Grid.Row="1" Grid.Column="3" Text="$0.00" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- TARJETA -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="💳 Tarjeta" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <TextBox x:Name="txtContadoTarjeta" Grid.Row="2" Grid.Column="1" Text="0" Width="90" Height="34" Style="{StaticResource TxtCorteCelda}" TextChanged="ContadoCorte_TextChanged"/>
                            <TextBlock x:Name="txtCalculadoTarjeta" Grid.Row="2" Grid.Column="2" Text="$0.00" FontSize="14" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtDiferenciaTarjeta" Grid.Row="2" Grid.Column="3" Text="$0.00" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- TRANSFERENCIA -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="🏦 Transferencia" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <TextBox x:Name="txtContadoTransferencia" Grid.Row="3" Grid.Column="1" Text="0" Width="90" Height="34" Style="{StaticResource TxtCorteCelda}" TextChanged="ContadoCorte_TextChanged"/>
                            <TextBlock x:Name="txtCalculadoTransferencia" Grid.Row="3" Grid.Column="2" Text="$0.00" FontSize="14" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtDiferenciaTransferencia" Grid.Row="3" Grid.Column="3" Text="$0.00" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Rectangle Grid.Row="4" Grid.ColumnSpan="4" Fill="#E2E8F0"/>

                            <!-- TOTAL -->
                            <Border Grid.Row="5" Grid.ColumnSpan="4" Background="#EFF6FF" CornerRadius="0,0,10,10"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="TOTAL" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <TextBlock x:Name="txtCorteContado" Grid.Row="5" Grid.Column="1" Text="$0.00" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtCorteEsperado" Grid.Row="5" Grid.Column="2" Text="$0.00" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtCorteDiferencia" Grid.Row="5" Grid.Column="3" Text="$0.00" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Cancelar"
                                Height="46"
                                Background="#F1F5F9"
                                Foreground="#475569"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnCancelarCorte_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2"
                                Content="✅ Confirmar Corte y Cerrar Caja"
                                Height="46"
                                Style="{StaticResource BtnCerrarCajaEstilo}"
                                Click="BtnConfirmarCorte_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Border>

    </Grid>

</Window>