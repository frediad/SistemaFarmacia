<Window x:Class="FarmaciaPOS.Views.PedidosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedidos Online"
        Height="740"
        Width="1150"
        Icon="/farma.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <Window.Resources>

        <!-- ✅ ComboBoxItem de estado, mismos colores que los botones originales -->
        <Style x:Key="ItemEstado" TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="⏳ Pendiente">
                    <Setter Property="Background" Value="#FEF9C3"/>
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="👌 Confirmado">
                    <Setter Property="Background" Value="#D1FAE5"/>
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="⚙️ Preparando">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="🛍️ Listo para recoger">
                    <Setter Property="Background" Value="#EDE9FE"/>
                    <Setter Property="Foreground" Value="#6D28D9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="🚚 En camino">
                    <Setter Property="Background" Value="#FFEDD5"/>
                    <Setter Property="Foreground" Value="#9A3412"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="✅ Entregado">
                    <Setter Property="Background" Value="#DCFCE7"/>
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="❌ Cancelado">
                    <Setter Property="Background" Value="#FEE2E2"/>
                    <Setter Property="Foreground" Value="#991B1B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ El combo en sí toma el color del item seleccionado, para que
             siempre se vea igual de claro que antes con los botones -->
        <Style x:Key="CboCambiarEstado" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ✅ Botones de filtro de periodo — mismo patrón que Ventas/Clientes -->
        <Style x:Key="BtnFiltroPeriodoPedidos" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnFiltroPeriodoPedidosActivo" TargetType="Button" BasedOn="{StaticResource BtnFiltroPeriodoPedidos}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

        <!-- Botón "Actualizar" -->
        <Style x:Key="BtnActualizar" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================= -->
        <!-- HEADER                                    -->
        <!-- ========================================= -->

        <Border Background="#1E3A8A"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📦 Pedidos Online"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <!-- ✅ Badge de pedidos nuevos -->
                    <TextBlock x:Name="txtBadgeNuevosPedidos"
                               Text="🔔 1 pedido nuevo"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#FDE047"
                               Margin="2,2,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- BUSCADOR POR CLIENTE -->

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="8"
                        Margin="10,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🔍"
                                   FontSize="16"
                                   Margin="10,0,5,0"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtBuscarCliente"
                                 Grid.Column="1"
                                 Height="38"
                                 FontSize="14"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtBuscarCliente_TextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="Transparent">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="4,0"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>

                    </Grid>

                </Border>

                <!-- FILTRO ESTADO -->

                <ComboBox x:Name="cbEstado"
                          Grid.Column="2"
                          Height="38"
                          FontSize="14"
                          Margin="0,0,10,0"
                          BorderThickness="0"
                          Background="White"
                          SelectionChanged="cbEstado_SelectionChanged">

                    <ComboBoxItem Content="Todos los pedidos"/>
                    <ComboBoxItem Content="Pendiente"/>
                    <ComboBoxItem Content="Confirmado"/>
                    <ComboBoxItem Content="Preparando"/>
                    <ComboBoxItem Content="Listo para recoger"/>
                    <ComboBoxItem Content="En camino"/>
                    <ComboBoxItem Content="Entregado"/>
                    <ComboBoxItem Content="Cancelado"/>

                </ComboBox>

                <!-- ✅ BOTÓN ACTUALIZAR -->

                <Button Grid.Column="3"
                        Content="🔄 Actualizar"
                        Width="120"
                        Height="38"
                        Style="{StaticResource BtnActualizar}"
                        Margin="0,0,10,0"
                        Click="BtnActualizarPedidos_Click"/>

                <!-- BOTÓN CERRAR -->

                <Button Grid.Column="4"
                        Content="✕ Cerrar"
                        Width="110"
                        Height="38"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="#DC2626"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Right"
                        Click="BtnCerrarVentana_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>

        </Border>

        <!-- ========================================= -->
        <!-- ✅ FILTRO DE PERIODO                       -->
        <!-- ========================================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,12">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Periodo:"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <Button x:Name="btnFiltroHoyPedidos" Content="Hoy"
                        Style="{StaticResource BtnFiltroPeriodoPedidos}"
                        Click="BtnFiltroPeriodoPedidos_Click" Tag="Dia"/>

                <Button x:Name="btnFiltroSemanaPedidos" Content="Semana"
                        Style="{StaticResource BtnFiltroPeriodoPedidos}"
                        Click="BtnFiltroPeriodoPedidos_Click" Tag="Semana"/>

                <Button x:Name="btnFiltroMesPedidos" Content="Mes"
                        Style="{StaticResource BtnFiltroPeriodoPedidos}"
                        Click="BtnFiltroPeriodoPedidos_Click" Tag="Mes"/>

                <Button x:Name="btnFiltroAnioPedidos" Content="Año"
                        Style="{StaticResource BtnFiltroPeriodoPedidos}"
                        Click="BtnFiltroPeriodoPedidos_Click" Tag="Anio"/>

                <Button x:Name="btnFiltroTodoPedidos" Content="Todo"
                        Style="{StaticResource BtnFiltroPeriodoPedidosActivo}"
                        Click="BtnFiltroPeriodoPedidos_Click" Tag="Todo"/>

            </StackPanel>

        </Border>

        <!-- ========================================= -->
        <!-- CONTENIDO                                 -->
        <!-- ========================================= -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <!-- LISTA DE PEDIDOS -->
                <ColumnDefinition Width="*"/>
                <!-- DETALLE -->
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================== -->
            <!-- TABLA DE PEDIDOS                      -->
            <!-- ===================================== -->

            <Border Background="White"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Lista de Pedidos"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="dgPedidos"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              FontSize="14"
                              RowHeight="42"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              SelectionChanged="DgPedidos_SelectionChanged">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="# Pedido"
                                Binding="{Binding NumeroPedido}"
                                Width="120"/>

                            <DataGridTextColumn Header="Cliente"
                                Binding="{Binding ClienteNombre}"
                                Width="*"/>

                            <DataGridTextColumn Header="Fecha"
                                Binding="{Binding FechaPedido, StringFormat=dd/MM/yyyy}"
                                Width="110"/>

                            <DataGridTextColumn Header="Total"
                                Binding="{Binding Total, StringFormat=C}"
                                Width="100"/>

                            <DataGridTemplateColumn Header="Estado"
                                                    Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12"
                                                Padding="8,3"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstadoPedido}"
                                                                     Value="Pendiente">
                                                            <Setter Property="Background" Value="#FEF9C3"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstadoPedido}"
                                                                     Value="Confirmado">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstadoPedido}"
                                                                     Value="Preparando">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstadoPedido}"
                                                                    Value="Listo para recoger">
                                                            <Setter Property="Background" Value="#EDE9FE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstadoPedido}"
                                                                     Value="En camino">
                                                            <Setter Property="Background" Value="#FFEDD5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstadoPedido}"
                                                                     Value="Entregado">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstadoPedido}"
                                                                     Value="Cancelado">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EstadoPedido}"
                                                       FontSize="12"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstadoPedido}"
                                                                         Value="Pendiente">
                                                                <Setter Property="Foreground" Value="#92400E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EstadoPedido}"
                                                                         Value="Confirmado">
                                                                <Setter Property="Foreground" Value="#166534"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EstadoPedido}"
                                                                         Value="Preparando">
                                                                <Setter Property="Foreground" Value="#1E40AF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EstadoPedido}"
                                                                         Value="Listo para recoger">
                                                                <Setter Property="Foreground" Value="#6D28D9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EstadoPedido}"
                                                                         Value="En camino">
                                                                <Setter Property="Foreground" Value="#9A3412"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EstadoPedido}"
                                                                         Value="Entregado">
                                                                <Setter Property="Foreground" Value="#166534"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EstadoPedido}"
                                                                         Value="Cancelado">
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- ===================================== -->
            <!-- PANEL DETALLE                         -->
            <!-- ===================================== -->

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO DETALLE -->

                    <TextBlock Text="Detalle del Pedido"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,12"/>

                    <!-- INFO CLIENTE -->

                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,4">
                                <TextBlock Text="👤  "
                                           FontSize="14"/>
                                <TextBlock x:Name="txtDetalleCliente"
                                           Text="—"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,4">
                                <TextBlock Text="📅  "
                                           FontSize="13"/>
                                <TextBlock x:Name="txtDetalleFecha"
                                           Text="—"
                                           FontSize="13"
                                           Foreground="#64748B"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,4">
                                <TextBlock Text="🕐  "
                                           FontSize="13"/>
                                <TextBlock x:Name="txtDetalleHora"
                                           Text="—"
                                           FontSize="13"
                                           Foreground="#64748B"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝  "
                                           FontSize="13"/>
                                <TextBlock x:Name="txtDetalleObservaciones"
                                           Text="—"
                                           FontSize="13"
                                           Foreground="#64748B"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- ✅ CAMBIAR ESTADO (ahora como lista desplegable) -->

                    <Border Grid.Row="2"
                            Background="#EFF6FF"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,12">

                        <StackPanel>

                            <TextBlock Text="Cambiar Estado"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#1E40AF"
                                       Margin="0,0,0,8"/>

                            <ComboBox x:Name="cbCambiarEstado"
                                      Style="{StaticResource CboCambiarEstado}"
                                      SelectionChanged="cbCambiarEstado_SelectionChanged">

                                <ComboBoxItem Content="⏳ Pendiente" Tag="Pendiente" Style="{StaticResource ItemEstado}"/>
                                <ComboBoxItem Content="👌 Confirmado" Tag="Confirmado" Style="{StaticResource ItemEstado}"/>
                                <ComboBoxItem Content="⚙️ Preparando" Tag="Preparando" Style="{StaticResource ItemEstado}"/>
                                <ComboBoxItem Content="🛍️ Listo para recoger" Tag="Listo para recoger" Style="{StaticResource ItemEstado}"/>
                                <ComboBoxItem Content="🚚 En camino" Tag="En camino" Style="{StaticResource ItemEstado}"/>
                                <ComboBoxItem Content="✅ Entregado" Tag="Entregado" Style="{StaticResource ItemEstado}"/>
                                <ComboBoxItem Content="❌ Cancelado" Tag="Cancelado" Style="{StaticResource ItemEstado}"/>

                            </ComboBox>

                            <!--  aviso visible cuando el pedido ya no se puede modificar -->
                            <TextBlock x:Name="txtPedidoFinalizado"
                                       Text="🔒 Este pedido ya está finalizado y no se puede modificar"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#991B1B"
                                       Margin="0,8,0,0"
                                       Visibility="Collapsed"/>

                        </StackPanel>

                    </Border>

                    <!-- PRODUCTOS DEL PEDIDO -->

                    <TextBlock Grid.Row="3"
                               Text="Productos del pedido"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#374151"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="dgDetallePedido"
                              Grid.Row="4"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              FontSize="13"
                              RowHeight="36"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>

                            <!-- Producto -->
                            <DataGridTextColumn Header="Producto"
                            Binding="{Binding Nombre}"
                            Width="*"/>

                            <!-- Cantidad -->
                            <DataGridTextColumn Header="Cant."
                            Binding="{Binding Cantidad}"
                            Width="60"/>

                            <!-- Precio -->
                            <DataGridTextColumn Header="Precio"
                            Binding="{Binding Precio, StringFormat={}{0:C2}}"
                            Width="90"/>

                            <!-- Subtotal -->
                            <DataGridTextColumn Header="Subtotal"
                            Binding="{Binding Subtotal, StringFormat={}{0:C2}}"
                            Width="90"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- TOTAL PEDIDO -->

                    <Border Grid.Row="5"
                            Background="#1E3A8A"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,10,0,0">

                        <Grid>

                            <TextBlock Text="TOTAL"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#93C5FD"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="txtDetalleTotalPedido"
                                       Text="$0.00"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
