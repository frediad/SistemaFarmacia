<Window x:Class="FarmaciaPOS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Sesión"
        Height="560"
        Width="880"
        Icon="/farma.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Login_PreviewKeyDown">

    <Window.Resources>

        <!-- ===================================== -->
        <!-- GRADIENTE DE MARCA (reutilizable)     -->
        <!-- ===================================== -->

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E3A8A" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===================================== -->
        <!-- ESTILO CAMPOS DE TEXTO                -->
        <!-- ===================================== -->

        <Style x:Key="TxtLogin" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="44,0,14,0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="CaretBrush" Value="#2563EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================== -->
        <!-- ESTILO CONTRASEÑA                     -->
        <!-- ===================================== -->

        <Style x:Key="PwdLogin" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="44,0,14,0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="CaretBrush" Value="#2563EB"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================== -->
        <!-- ESTILO BOTÓN INICIAR SESIÓN           -->
        <!-- ===================================== -->

        <Style x:Key="BtnLoginPrincipal" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Iniciar Sesión" VerticalAlignment="Center"/>
                                <Path Data="M0,0 L6,5 L0,10"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeatureBullet" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

    </Window.Resources>

    <!-- ✅ Arrastrar la ventana (no hay barra de título nativa) -->
    <Border x:Name="borderVentana"
            Background="White"
            CornerRadius="20"
            Margin="18"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.25"
                              BlurRadius="35"
                              ShadowDepth="8"/>
        </Border.Effect>

        <Border.Clip>
            <RectangleGeometry Rect="0,0,924,524" RadiusX="20" RadiusY="20"/>
        </Border.Clip>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================== -->
            <!-- DIVISOR ONDULADO (capa de fondo)      -->
            <!-- ===================================== -->
            <!-- Dibuja TODO el área azul con un borde derecho ondulado,
                 en vez de depender de la línea recta de la columna.
                 Va primero en el árbol visual = queda debajo del contenido. -->

            <Path Grid.ColumnSpan="2"
                  HorizontalAlignment="Left"
                  Width="440"
                  Height="524"
                  Fill="{StaticResource BrandGradient}"
                  Data="M0,0 L340,0
                        C 510,70 270,150 348,210
                        C 460,270 268,360 340,430
                        C 400,470 300,495 340,524
                        L0,524 Z">
                <Path.Effect>
                    <DropShadowEffect Color="#1E3A8A"
                                      Opacity="0.25"
                                      BlurRadius="14"
                                      ShadowDepth="0"/>
                </Path.Effect>
            </Path>

            <!-- ===================================== -->
            <!-- BOTÓN CERRAR (por WindowStyle=None)   -->
            <!-- ===================================== -->

            <Button x:Name="btnCerrarLogin"
                    Grid.ColumnSpan="2"
                    Content="✕"
                    Width="34" Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,14,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#94A3B8"
                    FontSize="14"
                    Cursor="Hand"
                    Click="BtnCerrarLogin_Click"
                    Panel.ZIndex="10"/>

            <!-- ===================================== -->
            <!-- PANEL IZQUIERDO — MARCA (contenido)   -->
            <!-- ===================================== -->

            <Grid Grid.Column="0" ClipToBounds="True">

                <!-- Patrón decorativo: rombos concéntricos -->
                <Canvas>
                    <Path Data="M75,-30 L155,50 L75,130 L-5,50 Z"
                          Stroke="White" StrokeThickness="1.4" Opacity="0.10"/>
                    <Path Data="M75,10 L135,70 L75,130 L15,70 Z"
                          Stroke="White" StrokeThickness="1.4" Opacity="0.14"/>
                    <Path Data="M260,300 L330,370 L260,440 L190,370 Z"
                          Stroke="White" StrokeThickness="1.4" Opacity="0.08"/>
                    <Path Data="M280,320 L320,360 L280,400 L240,360 Z"
                          Fill="White" Opacity="0.05"/>
                </Canvas>

                <!-- Silueta escalonada tipo pirámide -->
                <StackPanel VerticalAlignment="Bottom">
                    <Border Height="14" Width="330" Background="White" Opacity="0.05" HorizontalAlignment="Center"/>
                    <Border Height="14" Width="270" Background="White" Opacity="0.06" HorizontalAlignment="Center"/>
                    <Border Height="14" Width="210" Background="White" Opacity="0.08" HorizontalAlignment="Center"/>
                    <Border Height="14" Width="150" Background="White" Opacity="0.10" HorizontalAlignment="Center"/>
                    <Border Height="14" Width="90"  Background="White" Opacity="0.12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Contenido: logo, nombre, features -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="40,0">

                    <Border Background="White"
                            CornerRadius="24"
                            Width="110"
                            Height="110"
                            HorizontalAlignment="Center">

                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              Opacity="0.20"
                                              BlurRadius="18"
                                              ShadowDepth="4"/>
                        </Border.Effect>

                        <Image Source="/Images/logo-click.png"
                               Width="80"
                               Height="86"
                               Stretch="Uniform"/>

                    </Border>

                    <TextBlock Text="Farmacia Yatzil"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,4"/>

                    <TextBlock Text="Tu sistema de ventas de confianza"
                               Foreground="#BFDBFE"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,32"/>

                    <StackPanel Style="{StaticResource FeatureBullet}">
                        <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" Opacity="0.15"/>
                        <Path Data="M1,5 L4,8 L10,1" Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Margin="-17,6,0,0" Width="10" Height="9"/>
                        <TextBlock Text="Ventas y cobro rápido en punto de venta"
                                   Foreground="White" FontSize="12.5" Opacity="0.9"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FeatureBullet}">
                        <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" Opacity="0.15"/>
                        <Path Data="M1,5 L4,8 L10,1" Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Margin="-17,6,0,0" Width="10" Height="9"/>
                        <TextBlock Text="Control de inventario y caducidades"
                                   Foreground="White" FontSize="12.5" Opacity="0.9"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FeatureBullet}">
                        <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" Opacity="0.15"/>
                        <Path Data="M1,5 L4,8 L10,1" Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Margin="-17,6,0,0" Width="10" Height="9"/>
                        <TextBlock Text="Reportes y cortes de caja en tiempo real"
                                   Foreground="White" FontSize="12.5" Opacity="0.9"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    
                    <TextBlock Text="¡Y mucho más!"
                               Foreground="White"
                               FontSize="12.5"
                               Opacity="0.9"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    
                    <TextBlock Text="¡Vende con amor, compra con amor!"
                               Foreground="White"
                               FontSize="15"
                               Opacity="0.9"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>

                </StackPanel>
                
                

                <TextBlock Text="© 2026 FarmaClick Yatzil — v1.0"
                           Foreground="#BFDBFE"
                           FontSize="11"
                           Opacity="0.7"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,18"/>

            </Grid>

            <!-- ===================================== -->
            <!-- PANEL DERECHO — FORMULARIO            -->
            <!-- ===================================== -->


            <Border Grid.Column="1" Background="Transparent">

                <StackPanel Width="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="Bienvenido 👋"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>

                    <TextBlock Text="Ingresa tus credenciales para continuar"
                               FontSize="13"
                               Foreground="#94A3B8"
                               Margin="0,4,0,28"/>

                    <Border x:Name="borderError"
                            Background="#FEE2E2"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#DC2626"
                                     VerticalAlignment="Top" Margin="0,4,8,0"/>
                            <TextBlock x:Name="txtError"
                                       Text="Usuario o contraseña incorrectos"
                                       Foreground="#DC2626"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Width="300"/>
                        </StackPanel>

                    </Border>

                    <TextBlock Text="USUARIO"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#94A3B8"
                               Margin="2,0,0,6"/>

                    <Grid Margin="0,0,0,20">
                        <TextBox x:Name="txtUsuario"
                                 Height="48"
                                 Style="{StaticResource TxtLogin}"/>
                        <Canvas Width="14" Height="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                IsHitTestVisible="False">
                            <Ellipse Canvas.Left="3.5" Canvas.Top="0" Width="7" Height="7" Fill="#94A3B8"/>
                            <Path Data="M0,14 C0,9.5 3.5,8 7,8 C10.5,8 14,9.5 14,14 Z" Fill="#94A3B8"/>
                        </Canvas>
                    </Grid>

                    <TextBlock Text="CONTRASEÑA"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#94A3B8"
                               Margin="2,0,0,6"/>

                    <Grid Margin="0,0,0,30">
                        <PasswordBox x:Name="txtPassword"
                                     Height="48"
                                     Style="{StaticResource PwdLogin}"/>
                        <Canvas Width="14" Height="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                IsHitTestVisible="False">
                            <Rectangle Canvas.Top="6" Width="14" Height="8" RadiusX="2" RadiusY="2" Fill="#94A3B8"/>
                            <Path Data="M3,6 V4.5 A4,4 0 0 1 11,4.5 V6"
                                  Stroke="#94A3B8" StrokeThickness="2" Fill="Transparent"/>
                        </Canvas>
                    </Grid>

                    <Button Content="Iniciar Sesión"
                            Height="50"
                            Style="{StaticResource BtnLoginPrincipal}"
                            Click="BtnLogin_Click"/>

                    <TextBlock x:Name="txtCrearAdmin"
                               Text="¿No tienes cuenta? Crear usuario administrador"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"
                               Cursor="Hand"
                               Visibility="Visible"
                               MouseLeftButtonUp="TxtCrearAdmin_Click"/>

                </StackPanel>
            </Border>

        </Grid>

    </Border>

</Window>