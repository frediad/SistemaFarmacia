<Window x:Class="FarmaciaPOS.Views.AcercaDelSistema"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca del Sistema"
        Height="640"
        Width="480"
        Icon="/farma.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F4F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="BotonModerno" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- LOGO / ICONO -->
        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
            <Border Width="80" Height="80" CornerRadius="20" Background="#1E3A8A">
                <TextBlock Text="💊" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Sistema Farmacia POS" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            <TextBlock x:Name="txtVersion" Text="Versión 1.0.0" FontSize="13" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- INFO -->
        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Acerca de este sistema" FontSize="14" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#374151" Margin="0,0,0,20"
                           Text="Sistema Farmacia POS es una aplicación de punto de venta e inventario diseñada para la gestión integral de farmacias: control de productos, caducidades, ventas, clientes y reportes."/>

                    <Separator Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Desarrollado por:" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="txtDesarrollador" Text="Equipo de Desarrollo" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Fecha de compilación:" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="txtFecha" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Plataforma:" FontSize="12" Foreground="Gray"/>
                        <TextBlock Text=".NET 8 / WPF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Base de datos:" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="txtModoBD" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- BOTÓN CERRAR -->
        <Button Grid.Row="2"
                Content="⬅  Cerrar"
                Width="150" Height="42"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Background="#616161"
                Style="{StaticResource BotonModerno}"
                Click="BtnCerrar_Click"/>

    </Grid>

</Window>
