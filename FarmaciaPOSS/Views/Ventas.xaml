<Window x:Class="FarmaciaPOS.Views.VentasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FarmaciaPOS.Views"
        Title="Punto de Venta"
        Height="750"
        Width="1200"
        Icon="/farma.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8"
        PreviewKeyDown="VentasWindow_PreviewKeyDown">

    <Window.Resources>

        <!-- ===================================== -->
        <!-- ESTILO BOTONES CATEGORÍA              -->
        <!-- ===================================== -->

        <Style x:Key="BtnCategoria" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnCategoriaActiva" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================== -->
        <!-- ESTILO SCROLLBAR HORIZONTAL CATEGORÍAS -->
        <!-- ===================================== -->

        <Style x:Key="ScrollBarThumbCategorias" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#CBD5E1"
                                CornerRadius="4"
                                Height="6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarCategorias" TargetType="ScrollBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbCategorias}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================== -->
        <!-- ESTILO BOTÓN COBRAR                   -->
        <!-- ===================================== -->

        <Style x:Key="BtnCobrar" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================== -->
        <!-- ESTILO BOTONES ACCIÓN INFERIOR         -->
        <!-- ===================================== -->

        <Style x:Key="BtnAccion" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones pequeños de la barra del ticket -->
        <Style x:Key="BtnTicketAccion" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================== -->
        <!-- ESTILO PESTAÑAS PRINCIPALES            -->
        <!-- ===================================== -->

        <Style x:Key="TabPrincipal" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="#2563EB"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="#94A3B8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,3"/>
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de filtro de periodo (Día/Semana/Mes/Año) -->
        <Style x:Key="BtnFiltroPeriodo" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnFiltroPeriodoActivo" TargetType="Button" BasedOn="{StaticResource BtnFiltroPeriodo}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

        <!-- Botón pequeño de acción dentro de una fila del historial -->
        <Style x:Key="BtnFilaHistorial" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,4"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================= -->
        <!-- HEADER                                    -->
        <!-- ========================================= -->

        <Border Background="#1E3A8A" Grid.Row="0">

            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🛒  Ventas"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="✕ Cerrar"
                        Width="100"
                        Height="38"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="#DC2626"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnCerrarVentana_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>

        </Border>

        <!-- ========================================= -->
        <!-- PESTAÑAS PRINCIPALES                      -->
        <!-- ========================================= -->

        <TabControl Grid.Row="1"
                    x:Name="tabPrincipal"
                    Background="#F0F4F8"
                    BorderThickness="0"
                    Padding="0">

            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabPrincipal}"/>
            </TabControl.Resources>

            <!-- ===================================================== -->
            <!-- TAB 1: PUNTO DE VENTA                                 -->
            <!-- ===================================================== -->

            <TabItem Header="🛒 Punto de Venta">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="110"/>
                    </Grid.RowDefinitions>

                    <!-- CONTENIDO: CARRITO | CATÁLOGO -->
                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>

                        <!-- CARRITO DE VENTA -->
                        <Grid Margin="8,8,4,8">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="55"/>
                            </Grid.RowDefinitions>

                            <Border Background="#1E3A8A" CornerRadius="10,10,0,0">

                                <Grid Margin="15,0">

                                    <TextBlock Text="🧾  Ticket actual"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                        <Button Content="＋ Cant"
                                                Style="{StaticResource BtnTicketAccion}"
                                                Click="BtnMasCant_Click"/>

                                        <Button Content="🔢 Cant."
                                                Style="{StaticResource BtnTicketAccion}"
                                                Click="BtnCantidad_Click"/>

                                        <Button Content="🏷️ Desc."
                                                Style="{StaticResource BtnTicketAccion}"
                                                Click="BtnDescuento_Click"/>

                                        <Button Content="🗑️ Quitar"
                                                Style="{StaticResource BtnTicketAccion}"
                                                Background="#DC2626"
                                                Click="BtnEliminar_Click"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <Border Grid.Row="1"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1,0,1,0">

                                <DataGrid x:Name="dgCarrito"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          FontSize="14"
                                          RowHeight="38"
                                          BorderThickness="0"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="65"/>
                                        <DataGridTextColumn Header="Descripción" Binding="{Binding Nombre}" Width="*"/>
                                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/>
                                        <DataGridTextColumn Header="Desc." Binding="{Binding Descuento}" Width="80"/>
                                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="100"/>
                                        <DataGridTextColumn Header="Importe" Binding="{Binding Subtotal}" Width="110"/>
                                    </DataGrid.Columns>

                                </DataGrid>

                            </Border>

                            <Border Grid.Row="2"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1,1,1,1"
                                    CornerRadius="0,0,10,10">

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0">

                                    <Button Content="✕ Cancelar venta"
                                            Style="{StaticResource BtnAccion}"
                                            Width="140"
                                            Height="36"
                                            Margin="4,0"
                                            Click="BtnCancelar_Click"/>

                                    <Button Content="🖨️ Generar Ticket"
                                            Style="{StaticResource BtnAccion}"
                                            Width="150"
                                            Height="36"
                                            Margin="4,0"
                                            Click="BtnGenerarTicket_Click"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <!-- CATÁLOGO: CATEGORÍAS + PRODUCTOS CARDS -->
                        <Border Grid.Column="1"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1,0,0,0"
                                Margin="4,8,8,8">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="65"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0"
                                                      Padding="0,0,0,4">

                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarCategorias}"/>
                                            </ScrollViewer.Resources>

                                            <StackPanel x:Name="pnlCategorias"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                            </StackPanel>

                                        </ScrollViewer>

                                        <Button Grid.Column="1"
                                                Content="🔍"
                                                Width="46"
                                                Height="42"
                                                FontSize="18"
                                                Background="#2563EB"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="0,0,10,0"
                                                Click="BtnBuscarProducto_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </Grid>

                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                                    <ItemsControl x:Name="icProductosCatalogo">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" Margin="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Border Width="160"
                                                        Height="200"
                                                        Margin="5"
                                                        Background="White"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="CardProducto_MouseLeftButtonUp">

                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect Color="#2563EB"
                                                                                              Opacity="0.15"
                                                                                              BlurRadius="8"
                                                                                              ShadowDepth="2"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="115"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- IMAGEN -->
                                                        <Border Background="#F1F5F9"
                                                                CornerRadius="12,12,0,0">

                                                            <Image Source="{Binding ImagenBytes, Converter={StaticResource ByteArrayToImageConverter}}"
                                                                   Stretch="Uniform"
                                                                   Margin="10"/>

                                                        </Border>

                                                        <!-- INFO -->
                                                        <StackPanel Grid.Row="1"
                                                                    Margin="10,6">

                                                            <TextBlock Text="{Binding Nombre}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Foreground="#1E293B"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="36"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Text="{Binding PrecioVenta, StringFormat=C}"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="#2563EB"
                                                                       Margin="0,4,0,0"/>

                                                            <TextBlock Text="{Binding Stock, StringFormat='Stock: {0}'}"
                                                                       FontSize="11"
                                                                       Foreground="#94A3B8"/>

                                                        </StackPanel>

                                                    </Grid>

                                                </Border>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </ScrollViewer>

                            </Grid>

                        </Border>

                    </Grid>

                    <!-- TOTAL + COBRAR -->
                    <Grid Grid.Row="1" Margin="8,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="4,8">

                            <Grid Margin="20,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtTotal" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PAGO" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtPago" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#374151"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="CAMBIO" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtCambio" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#16A34A"/>
                                </StackPanel>

                            </Grid>

                        </Border>

                        <Button Grid.Column="1"
                                Content="💳  COBRAR"
                                Style="{StaticResource BtnCobrar}"
                                Margin="4,8"
                                Click="BtnCobrar_Click"/>

                    </Grid>

                </Grid>

            </TabItem>

            <!-- ===================================================== -->
            <!-- TAB 2: HISTORIAL DE VENTAS                            -->
            <!-- ===================================================== -->

            <TabItem Header="📋 Historial de Ventas">

                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- FILTROS DE PERIODO -->
                    <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">

                        <StackPanel Orientation="Horizontal">

                            <Button x:Name="btnFiltroDia" Content="📅 Hoy"
                                    Style="{StaticResource BtnFiltroPeriodoActivo}"
                                    Click="BtnFiltroPeriodo_Click" Tag="Dia"/>

                            <Button x:Name="btnFiltroSemana" Content="📅 Esta semana"
                                    Style="{StaticResource BtnFiltroPeriodo}"
                                    Click="BtnFiltroPeriodo_Click" Tag="Semana"/>

                            <Button x:Name="btnFiltroMes" Content="📅 Este mes"
                                    Style="{StaticResource BtnFiltroPeriodo}"
                                    Click="BtnFiltroPeriodo_Click" Tag="Mes"/>

                            <Button x:Name="btnFiltroAño" Content="📅 Este año"
                                    Style="{StaticResource BtnFiltroPeriodo}"
                                    Click="BtnFiltroPeriodo_Click" Tag="Anio"/>

                            <Button x:Name="btnFiltroTodo" Content="📅 Todo"
                                    Style="{StaticResource BtnFiltroPeriodo}"
                                    Click="BtnFiltroPeriodo_Click" Tag="Todo"/>

                            <Button Content="🔄 Actualizar"
                                    Style="{StaticResource BtnFiltroPeriodo}"
                                    Margin="20,0,0,0"
                                    Click="BtnActualizarHistorial_Click"/>

                            <TextBlock x:Name="txtTotalHistorial"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#1E3A8A"
                                       VerticalAlignment="Center"
                                       Margin="20,0,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- TABLA DE HISTORIAL -->
                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12">

                        <DataGrid x:Name="dgHistorialVentas"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  FontSize="13"
                                  RowHeight="42"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="100"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="140"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                                <DataGridTextColumn Header="Vendedor" Binding="{Binding Vendedor}" Width="130"/>
                                <DataGridTextColumn Header="Método de pago" Binding="{Binding MetodoPago}" Width="130"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="110"/>

                                <DataGridTemplateColumn Header="Ticket" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🖨️ Reimprimir"
                                                    Style="{StaticResource BtnFilaHistorial}"
                                                    Click="BtnReimprimirTicket_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

            </TabItem>

            <!-- ===================================================== -->
            <!-- TAB 3: ESTADÍSTICAS                                   -->
            <!-- ===================================================== -->

            <TabItem Header="📊 Estadísticas">

                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition Width="965*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TARJETA: VENTAS MENSUALES -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="14"
                            Padding="24"
                            Margin="0,0,0,16"
                            MaxWidth="480"
                            HorizontalAlignment="Left" Grid.ColumnSpan="2">

                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="14" ShadowDepth="3"/>
                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="📅 Ventas Mensuales"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txtEtiquetaMesActual"
                                           Text="AL —"
                                           FontSize="13"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="txtMontoMesActual"
                                           Grid.Column="1"
                                           Text="$0.00"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#2563EB"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txtEtiquetaMesAnterior"
                                           Text="AL —"
                                           FontSize="13"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="txtMontoMesAnterior"
                                               Text="$0.00"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#16A34A"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtPorcentajeMes"
                                               Text=" 0.0%"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="iconoMes"
                                               Text=" ▲"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Margin="0,14,0,10"/>

                            <TextBlock x:Name="txtDiferenciaMes"
                                       Text="$0.00"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"/>

                        </StackPanel>

                    </Border>

                    <!-- TARJETA: VENTAS ANUALES -->
                    <Border
                            Background="White"
                            CornerRadius="14"
                            Padding="24"
                            MaxWidth="480"
                            HorizontalAlignment="Left" Margin="0,213,0,0" Grid.RowSpan="2">

                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="14" ShadowDepth="3"/>
                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="📅 Ventas Anuales"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txtEtiquetaAnioActual"
                                           Text="AL —"
                                           FontSize="13"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="txtMontoAnioActual"
                                           Grid.Column="1"
                                           Text="$0.00"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#2563EB"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txtEtiquetaAnioAnterior"
                                           Text="AL —"
                                           FontSize="13"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="txtMontoAnioAnterior"
                                               Text="$0.00"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#16A34A"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtPorcentajeAño"
                                               Text=" 0.0%"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="iconoAño"
                                               Text=" ▲"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Margin="0,14,0,10"/>

                            <TextBlock x:Name="txtDiferenciaAnio"
                                       Text="$0.00"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</Window>
